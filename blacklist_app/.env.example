# Copia este archivo como .env y ajusta los valores:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Ejecución LOCAL (fuera de Docker), apuntando al Postgres de docker-compose
# que se publica en el puerto 5433 del host:
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/blacklist_db

# NOTA: dentro de docker-compose el servicio "app" ignora esta variable y usa
# postgresql://postgres:postgres@db:5432/blacklist_db (definida en el compose).

# ---------------------------------------------------------------------------
# Autenticación
# ---------------------------------------------------------------------------
# Genera un token seguro con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BEARER_TOKEN=dev-token-change-in-production

# ---------------------------------------------------------------------------
# Puertos publicados por docker-compose (opcionales)
# ---------------------------------------------------------------------------
#APP_PORT=3000
#DB_PORT=5433

# ---------------------------------------------------------------------------
# Flask (opcional, solo desarrollo)
# ---------------------------------------------------------------------------
#FLASK_ENV=development
#FLASK_DEBUG=1

# ---------------------------------------------------------------------------
# Despliegue
# ---------------------------------------------------------------------------
#IMAGE_NAME=blacklist-app
#IMAGE_TAG=latest
# ECR_REGISTRY=your-account-id.dkr.ecr.us-east-1.amazonaws.com
# ECR_REPOSITORY=blacklist-app
# AWS_REGION=us-east-1
